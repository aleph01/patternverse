{
  "name": "@patternverse/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP access to published Patternverse Commons over stdio and HTTP",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@patternverse/compiler": "workspace:*",
    "@patternverse/schema": "workspace:*",
    "@patternverse/workspace": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "22.18.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
