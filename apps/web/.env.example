# Public Dropbox application identifier. Never put the Dropbox app secret in a PUBLIC_ variable.
PUBLIC_DROPBOX_APP_KEY=your_dropbox_app_key

# Production web builds default to the smaller public release. Local development and
# the desktop app keep the full experience. Set individual switches to true as ready.
# VITE_RELEASE_PROFILE=core
# VITE_FEATURE_VOICE=true
# VITE_FEATURE_GUIDED_EXERCISES=true
# VITE_FEATURE_ADVANCED_MODELS=true
# VITE_FEATURE_DROPBOX_SYNC=true

# Expanded workspace sync: opt in only for a controlled preview until live-account
# validation is complete. Requires Dropbox sync above; does not enable it alone.
# VITE_WORKSPACE_DROPBOX_SYNC=true
# Sign-in-only preview: stores the validated workspace as readable JSON in Dropbox.
# Existing encrypted archives block this mode; no automatic decryption or downgrade.
# VITE_DROPBOX_SIGN_IN_ONLY=true

# Optional: your Dailymotion Web SDK Player ID (configure autostart off in Studio).
VITE_DAILYMOTION_PLAYER_ID=
