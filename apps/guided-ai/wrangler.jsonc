{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "patternverse-guided-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "QUOTAS", "class_name": "GuidedAiQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GuidedAiQuota"] }],
  "vars": { "ENABLED": "false", "ALLOWED_ORIGINS": "https://patternverse.org" },
  "routes": [{ "pattern": "patternverse.org/api/guided-ai/*", "zone_name": "patternverse.org" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.01 },
  },
  "build": { "command": "pnpm --filter @patternverse/guided-ai-worker build" },
}
