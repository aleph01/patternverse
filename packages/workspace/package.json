{
  "name": "@patternverse/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./backup": {
      "types": "./dist/backup.d.ts",
      "default": "./src/backup.ts"
    },
    "./practice-history": {
      "types": "./dist/practice-history.d.ts",
      "default": "./src/practice-history.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./public-practices": {
      "types": "./dist/public-practices.d.ts",
      "default": "./src/public-practices.ts"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "default": "./src/library.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@patternverse/schema": "workspace:*",
    "cborg": "6.1.3",
    "dexie": "4.4.4",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
