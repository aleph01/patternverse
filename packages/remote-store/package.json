{
  "name": "@patternverse/remote-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@patternverse/sync-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
